# vihat-miniapp — BẢN KÊ biến môi trường, và là tệp để chép ra khi chạy ở máy local:
#
#     cp .env.example .env.local      # rồi điền giá trị thật vào .env.local
#     chmod 600 .env.local            # nó sẽ chứa secret key thật và DSN có mật khẩu
#
# .env.local bị .gitignore chặn; tệp NÀY thì được theo dõi. Cố ý KHÔNG có
# .env.local.example: hai tệp cùng liệt kê một danh sách là hai tệp sẽ lệch nhau, và
# khi lệch thì không ai biết tệp nào đúng. Danh sách ở đây bị khoá bằng
# internal/config/ban_ke_bien_test.go — thêm biến mà quên một dòng thì `make check` đỏ.
#
# CHỈ PLACEHOLDER. Không bao giờ điền giá trị thật vào tệp này (nó nằm trong git).
# Thiếu một biến BẮT BUỘC thì service không khởi động và in ra đích danh tên biến.
#
# Đưa lên Kubernetes thì cùng năm biến này đi đường khác: xem deploy/README.md.

# BẮT BUỘC — không có CSDL thì không phục vụ nổi một yêu cầu nào.
# Dạng DSN Postgres. Phần host có thể mang nhiều host khi chạy nhiều node.
DATABASE_DSN=<dsn-postgres-lay-tu-kho-bi-mat>

# TUỲ CHỌN — mặc định ":8080".
LISTEN_ADDR=:8080

# BẮT BUỘC — định danh Mini App mà secret bên dưới thuộc về.
# Không phải bí mật. Bắt buộc vì một secret không kèm app id thì không ai xoay vòng
# hay chẩn đoán được nó; service in app id lúc khởi động để vận hành biết tiến trình
# này đang phục vụ Mini App nào.
ZALO_MINIAPP_APP_ID=<app-id-cua-mini-app>

# BẮT BUỘC — BÍ MẬT. Lấy từ kho bí mật lúc chạy, không bao giờ từ tệp này.
# Không có nó thì không đổi được phoneToken sang số điện thoại, tức là không ai đăng nhập được.
ZALO_MINIAPP_SECRET_KEY=<secret-key-lay-tu-kho-bi-mat>

# BẮT BUỘC — danh sách origin được phép gọi, ngăn cách bằng dấu phẩy.
# Không có nó thì nút đăng nhập chết im lặng trên máy thật (trình duyệt chặn, không báo gì).
# KHÔNG BAO GIỜ dùng "*". Xem README mục CORS để biết vì sao chọn những origin này.
CORS_ALLOWED_ORIGINS=https://h5.zdn.vn,https://zalo.me

# TUỲ CHỌN — chỉ dùng cho `go test ./internal/store`.
# Bỏ trống thì test chạm CSDL sẽ SKIP và nói rõ lý do (xem README).
TEST_DATABASE_DSN=

# ---------------------------------------------------------------------------
# BỐN BIẾN TUỲ CHỌN — bề mặt "yêu cầu tư vấn / gọi lại" (migrations/0003).
#
# Thiếu một NHÓM thì nhóm ấy TẮT và service vẫn khởi động, vẫn nhận yêu cầu tư
# vấn bình thường. Nửa nhóm (có token, thiếu mẫu) cũng là TẮT — xem zns.Moi và
# tongdai.Moi, cả hai trả nil khi thiếu bất kỳ mảnh nào.
# ---------------------------------------------------------------------------

# TUỲ CHỌN — BÍ MẬT. Access token của Official Account dùng để gửi ZNS.
# ⚠ Token này CÓ HẠN và gói internal/zns KHÔNG tự làm mới (nợ đã ghi trong
# README). Hết hạn thì yêu cầu vẫn ghi nhận được, chỉ tin xác nhận không tới.
ZALO_ZNS_ACCESS_TOKEN=<access-token-oa-lay-tu-kho-bi-mat>

# TUỲ CHỌN — mã mẫu ZNS ĐÃ ĐƯỢC ZALO DUYỆT. Không phải bí mật.
# Mẫu phải có một tham số tên `ma_yeu_cau`; xem internal/zns/client.go.
ZALO_ZNS_TEMPLATE_ID=

# TUỲ CHỌN — đích nhận lệnh quay số ra cho tính năng "gọi lại". Không phải bí mật.
# ⚠ Hình dạng dây CHƯA ĐO BẰNG MỘT LỜI GỌI THẬT — đọc khối đầu
# internal/tongdai/client.go trước khi điền giá trị trên môi trường thật.
TONGDAI_CALLBACK_URL=

# TUỲ CHỌN — BÍ MẬT. Khoá gửi kèm header Authorization tới đích ở trên.
TONGDAI_API_KEY=<khoa-tong-dai-lay-tu-kho-bi-mat>

# ---------------------------------------------------------------------------
# HAI BIẾN TUỲ CHỌN — cầu phiên công dân ViGov (internal/vigovcau).
#
# CẢ HAI HOẶC KHÔNG BIẾN NÀO. Cả hai trống: cầu tắt, đăng nhập chạy như cũ. Một
# nửa: service KHÔNG KHỞI ĐỘNG — nửa cấu hình là hỏng, không phải nửa bật.
# ⚠ Bật cầu thì /api/v1/sessions phát phiên của ViGov THAY CHO phiên của kho
# này — đọc README mục "Cầu phiên ViGov" trước khi điền.
# ---------------------------------------------------------------------------

# TUỲ CHỌN — cổng cầu phiên của service-identity (KHÔNG phải cổng 9090 giữa các
# service ViGov). Danh sách host:port ngăn bằng dấu phẩy, kể cả khi chỉ có một.
VIGOV_CITIZEN_SESSION_BRIDGE_ADDRESS=

# TUỲ CHỌN — BÍ MẬT, >= 32 byte. Một trong các khoá của CITIZEN_SESSION_BRIDGE_KEYS
# phía ViGov. KHÔNG BAO GIỜ là GRPC_CALLER_KEY của ViGov.
VIGOV_CITIZEN_SESSION_BRIDGE_KEY=<khoa-cau-phien-lay-tu-kho-bi-mat>

# TUỲ CHỌN — BÍ MẬT. App RIÊNG của từng xã: N cặp App ID → secret key, MỘT biến,
#     <app_id>=<secret>,<app_id>=<secret>
# App ID là dãy chữ số; secret KHÔNG được chứa dấu phẩy (dấu '=' thì được).
# KHÔNG khai lại app chung (ZALO_MINIAPP_APP_ID) ở đây. Rỗng: không có app riêng.
# Có giá trị mà cầu phiên ViGov (hai biến ở trên) trống: service KHÔNG KHỞI ĐỘNG —
# app riêng chỉ đăng nhập được qua cầu. Mỗi App ID ở đây cũng phải có một dòng
# `mini_app` chế độ riêng phía ViGov, không thì đăng nhập trả 422.
ZALO_MINIAPP_COMMUNE_APP_SECRETS=<cap-app-id-secret-lay-tu-kho-bi-mat>
